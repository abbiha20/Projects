{
     "compilerOptions": {
          "target": "es6",
          "module": "commonjs",
          "outDir": "dist",
          "rootDir": "src",
          "strict": true,
          "esModuleInterop": true,
          "skipLibCheck": true
     },
     "include": [
          "src/**/*.ts",
          "src/utils/logger.js"
     ],
     "exclude": [
          "node_modules"
     ]
}